{
    "name": "crustum/notification",
    "description": "Notification plugin for CakePHP applications - Multi-channel notification system",
    "type": "cakephp-plugin",
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
   "license": "MIT",
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "^5.1",
        "cakephp/authentication": "*",
        "cakephp/authorization": "*",
        "cakephp/queue": "^2.2"
    },
    "require-dev": {
        "boundwize/structarmed": "^0.15",
        "cakedc/cakephp-phpstan": "^4.3",
        "cakephp/bake": "^3.0",
        "cakephp/cakephp-codesniffer": "^5.3",
        "crustum/debug-bar": "dev-main",
        "crustum/plugin-manifest": "^1.2",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.5.0 | ^13.0",
        "ratchet/pawl": "^0.4",
        "react/http": "^1.7",
        "rector/rector": "^2.7"
    },
    "suggest": {
        "crustum/plugin-manifest": "CakePHP plugin installer",
        "crustum/notification-slack": "Slack notification channel",
        "crustum/notification-telegram": "Telegram notification channel",
        "crustum/notification-rocketchat": "RocketChat notification channel",
        "crustum/notification-webhook": "Webhook notification channel",
        "crustum/notification-broadcasting": "Broadcasting notification channel",
        "crustum/notification-seven": "Seven.io SMS notification channel",
        "crustum/notification-ui": "Notification UI plugin for web interface"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\Notification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestApp\\": "tests/TestApp/",
            "Crustum\\Notification\\Test\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@stan"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "phpunit --coverage-html coverage",
        "stan": "phpstan analyse src/ tests/",
        "psalm": "psalm --show-info=false",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan-tests": "phpstan analyze -c tests/phpstan.neon",
        "stan-baseline": "phpstan --generate-baseline",
        "structarmed": "vendor/bin/structarmed analyze src"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": false
    },
    "repositories": []
}
